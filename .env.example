# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Generate the session secret (32 bytes of hex, 64 chars):
#   openssl rand -hex 32
#
# The server refuses to start if SESSION_SECRET is shorter than 32 characters —
# a guessable signing key means anyone can forge an admin session cookie.

SESSION_SECRET=

# Mongo credentials. Used both to initialise the database and to build the
# connection string, so change them before the first `up` — after the volume
# exists, MONGO_INITDB_* is ignored and you would have to reset the volume.
MONGO_USER=bench
MONGO_PASSWORD=
MONGO_DB=bench

# Seeded on first boot only, when the users collection is empty.
# 12 characters minimum. Change it from the admin panel afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=

# false for local use over http://127.0.0.1 — which is the default setup.
# A Secure cookie is dropped by the browser on plain HTTP, so leaving this
# true locally makes login fail silently with no error shown.
# Set true the moment you put TLS in front (Caddy, Cloudflare Tunnel).
SECURE_COOKIES=false

# Number of proxy hops in front of the app. 0 for direct local access.
# Set to 1 behind a single reverse proxy, so the login rate-limiter sees real
# client IPs instead of counting everyone as the proxy. Unset means 0.
TRUST_PROXY=0

# Public URL once something is in front of the app. Admin (state-changing)
# requests whose Origin doesn't match this are rejected as cross-origin (CSRF).
# Behind a proxy, set it to the real URL, e.g. https://bench.example.com.
PUBLIC_ORIGIN=http://127.0.0.1:4000

# Ceiling on total uploaded-image bytes. Uploads are refused (507) past this,
# so no session can fill the volume that also holds the database. Default 512MB.
UPLOAD_BUDGET_BYTES=536870912

# Host interface the app binds. Loopback by default so a bare `node server.js`
# is never LAN-exposed. Docker overrides this to 0.0.0.0 (the published port,
# 127.0.0.1:4000:4000, is what restricts host access there).
BIND_HOST=127.0.0.1
